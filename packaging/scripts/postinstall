#!/bin/bash
# postinstall — runs after macOS Installer.app extracts XT-Forge.app
# to the install destination. In user-scope mode (see distribution.xml
# enable_currentUserHome="true") the pkg's declared install-location
# of /Applications is transparently re-rooted to ~/Applications, so
# the .app already lands in the right place.
#
# We just:
#   1. Strip the Gatekeeper quarantine flag so future launches don't
#      hit "Apple could not verify..." dialog.
#   2. Launch the newly-installed app.
#
# Installer positional args:
#   $0 script name  $1 pkg path  $2 install-destination  $3 volume
set +e

INSTALL_DEST="$2"
APP_PATH="$INSTALL_DEST/XT-Forge.app"

echo "[XT-Forge postinstall] INSTALL_DEST=$INSTALL_DEST HOME=$HOME USER=$USER"

# Defensive fallback: if $2 doesn't have the app (edge case on some
# macOS variants), probe the two most likely locations.
if [ ! -d "$APP_PATH" ]; then
    for candidate in "$HOME/Applications/XT-Forge.app" "/Applications/XT-Forge.app"; do
        if [ -d "$candidate" ]; then
            APP_PATH="$candidate"
            break
        fi
    done
fi

if [ ! -d "$APP_PATH" ]; then
    echo "[XT-Forge postinstall] ERROR: XT-Forge.app not found at $INSTALL_DEST or usual fallbacks" >&2
    exit 1
fi

xattr -dr com.apple.quarantine "$APP_PATH" 2>/dev/null

# `open -n` launches a fresh instance so the Installer's helper
# process doesn't accidentally get the frontmost slot.
open -n "$APP_PATH"

exit 0
